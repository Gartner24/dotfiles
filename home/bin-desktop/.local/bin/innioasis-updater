#!/bin/bash
# Innioasis Updater Launcher
# Generated by run_linux.sh installer

# Change to installation directory
cd "/home/santiago/.local/share/innioasis-updater" || {
    echo "Error: Cannot access installation directory: /home/santiago/.local/share/innioasis-updater" >&2
    exit 1
}

# Check if main application file exists
if [ ! -f "firmware_downloader.py" ]; then
    echo "Error: firmware_downloader.py not found in /home/santiago/.local/share/innioasis-updater" >&2
    exit 1
fi

# Determine Python executable to use
PYTHON_EXEC="python3"

# Activate virtual environment if it exists
if [ -f "venv/bin/activate" ]; then
    # Source the virtual environment
    source venv/bin/activate
    
    # Use the virtual environment's Python if available
    if [ -f "venv/bin/python" ]; then
        PYTHON_EXEC="./venv/bin/python"
    elif [ -f "venv/bin/python3" ]; then
        PYTHON_EXEC="./venv/bin/python3"
    fi
    
    echo "Using virtual environment Python: "
else
    echo "Warning: Virtual environment not found, using system Python"
fi

# Launch the application with the determined Python executable
exec $PYTHON_EXEC firmware_downloader.py "$@"
