# ╔══════════════════════════════════════╗
# ║      Ghostty — Gruvbox Dark Hard     ║
# ╚══════════════════════════════════════╝
# Port of .config/alacritty/alacritty.toml. Check with: ghostty +validate-config

command = /bin/zsh
# The account's login shell is bash, and Ghostty launched from the menu inherits
# SHELL=/usr/bin/bash from systemd - so Claude Code, nvim :terminal and yazi
# spawned bash. Alacritty sessions had zsh. (Root fix: chsh -s /usr/bin/zsh.)
env = SHELL=/bin/zsh

# ── Window ────────────────────────────────────────────────────────────────────
window-decoration  = false
background-opacity = 0.93
window-padding-x   = 0
window-padding-y   = 0

# ── Font ──────────────────────────────────────────────────────────────────────
font-family        = Hack Nerd Font Mono
font-size          = 12
# alacritty font.offset.y = 1: slight line-height breathing room
adjust-cell-height = 1

# ── Cursor ────────────────────────────────────────────────────────────────────
cursor-style       = block
cursor-style-blink = true
# Shell integration switches the cursor to a bar at the prompt; keep the block.
# ssh-env: set TERM=xterm-256color over ssh, so servers without Ghostty's
# terminfo (the VPSes) don't break backspace/colors.
shell-integration-features = no-cursor,ssh-env

# ── Mouse / selection ─────────────────────────────────────────────────────────
mouse-hide-while-typing = true
# copy-on-select left at Ghostty's default (true): selecting copies to the PRIMARY
# selection (middle-click paste), like Alacritty always did. Ctrl+Shift+C for clipboard.

# ── Colors — Gruvbox Dark Hard (same values as alacritty.toml) ────────────────
background           = #1d2021
foreground           = #ebdbb2
cursor-color         = #d5c4a1
cursor-text          = #1d2021
selection-background = #d5c4a1
selection-foreground = #1d2021
bold-color           = bright

palette = 0=#282828
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2

# ── Keybindings (same as alacritty) ───────────────────────────────────────────
# Ctrl+Space: send NUL so nvim-cmp completion works
keybind = ctrl+space=text:\x00
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = ctrl+up=scroll_page_lines:-1
keybind = ctrl+down=scroll_page_lines:1
keybind = ctrl+shift+k=clear_screen
# Prompt jumping lives in tmux (Ghostty only sees tmux's screen, not the shell's prompts)
keybind = ctrl+shift+page_up=unbind
keybind = ctrl+shift+page_down=unbind
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
